{
  "pluginAlias": "AristonGalevo",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Ariston GALEVO boiler control via Ariston NET.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "Ariston GALEVO",
        "required": true
      },
      "username": {
        "title": "Ariston NET Email",
        "type": "string",
        "required": true
      },
      "password": {
        "title": "Ariston NET Password",
        "type": "string",
        "required": true
      },
      "pollInterval": {
        "title": "Poll Interval (seconds)",
        "type": "integer",
        "default": 60,
        "minimum": 30,
        "description": "How often to poll the boiler state. Minimum 30 seconds to respect rate limits."
      }
    }
  }
}
